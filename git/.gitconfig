[user]
	name = Daniel Schatz
	email = daniel.schatz6437@gmail.com

[includeIf "gitdir:~/code"]
	path = ~/code/gitconfig

[alias]
	st = status -sb
	ci = commit
	all = commit -am
	br = branch
	co = checkout
	di = diff
	dic = diff --cached
	lg = log -p
	lol = log --graph --decorate --pretty=oneline --abbrev-commit
	lola = log --graph --decorate --pretty=oneline --abbrev-commit --all
	ls = ls-files
	ign = ls-files -o -i --exclude-standard

	unstage = reset HEAD --
	prev = checkout -
	discard = checkout --

[color]
	ui = auto
[color "branch"]
	current = yellow reverse
	local = yellow
	remote = green
[color "status"]
	added = yellow
	changed = green
	untracked = cyan
[core]
	whitespace = fix,-indent-with-non-tab,trailing-space,cr-at-eol
	editor = nvim
	quotepath = false
	excludesfile = ~/.gitignore
	autocrlf = input
[credential]
	helper = osxkeychain
[github]
	user = xd1i0
[mergetool]
	keepBackup = true
[push]
	default = current
[url "git@github.com:"]
	insteadOf = https://github.com/
[pull]
	rebase = false
[init]
	defaultBranch = main
