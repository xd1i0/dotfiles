{
  "permissions": {
    "allow": [
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(ls *)",
      "Bash(pwd)"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/.p8)",
      "Read(**/secrets/**)",
      "Read(**/credentials.json)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/id_rsa)",
      "Read(**/id_ed25519)",
      "Read(~/.aws/**)",
      "Read(~/.ssh/**)",
      "Read(~/Library/Keychains/**)",
      "Read(~/.kube/**)",
      "Read(~/.infisical/**)",
      "Bash(cat ~/.kube*)",
      "Bash(kubectl * get secret*)",
      "Bash(kubectl * get secrets*)",
      "Bash(kubectl get secret*)",
      "Bash(kubectl get secrets*)",
      "Bash(kubectl * describe secret*)",
      "Bash(kubectl describe secret*)",
      "Bash(kubectl config view*--raw*)",
      "Bash(kubectl * config view*--raw*)",
      "Bash(kubectl * create token*)",
      "Bash(kubectl create token*)",
      "Bash(kubectl * exec*)",
      "Bash(kubectl exec*)",
      "Bash(cat ~/.infisical*)",
      "Bash(infisical secrets*)",
      "Bash(infisical * secrets*)",
      "Bash(infisical export*)",
      "Bash(infisical * export*)",
      "Bash(infisical run*)",
      "Bash(infisical * run*)",
      "Bash(infisical token*)",
      "Bash(infisical * token*)",
      "Bash(cat *.env*)",
      "Bash(cat **/secrets/**)",
      "Bash(security find-generic-password*)",
      "Bash(security find-internet-password*)",
      "Bash(security dump-keychain*)",
      "Bash(security export*)",
      "Bash(*Co-Authored-By*)",
      "Bash(*co-authored-by*)"
    ]
  },
  "model": "opus",
  "enabledPlugins": {
    "rust-analyzer-lsp@claude-plugins-official": false,
    "swift-lsp@claude-plugins-official": false,
    "figma@claude-plugins-official": false,
    "frontend-design@claude-plugins-official": false,
    "superpowers@claude-plugins-official": false,
    "context7@claude-plugins-official": false,
    "security-guidance@claude-plugins-official": false,
    "feature-dev@claude-plugins-official": false,
    "andrej-karpathy-skills@karpathy-skills": false
  },
  "extraKnownMarketplaces": {
    "karpathy-skills": {
      "source": {
        "source": "github",
        "repo": "forrestchang/andrej-karpathy-skills"
      }
    }
  },
  "alwaysThinkingEnabled": false,
  "effortLevel": "medium",
  "tui": "fullscreen"
}
